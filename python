import urllib.request
import urllib.error

def fetch_raw_code():
    # ユーザーからURLを入力してもらう
    url = input("URLを入力してください: ").strip()
    
    if not url.startswith("https://"):
        print("エラー: URLは 'https://' から始まる必要があります。")
        return

    print(f"\nデータを取得中: {url}\n" + "-"*40)
    
    try:
        # Webサイトにリクエストを送信する際、拒否されないようにUser-Agentを設定
        req = urllib.request.Request(
            url, 
            headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'}
        )
        
        # URLを開いて中身を読み込む
        with urllib.request.urlopen(req) as response:
            # バイトデータを文字列に変換（UTF-8）
            raw_data = response.read().decode('utf-8')
            
            # 取得したコードをそのまま表示
            print(raw_data)
            
    except urllib.error.HTTPError as e:
        print(f"HTTPエラーが発生しました: {e.code} - {e.reason}")
    except urllib.error.URLError as e:
        print(f"URLエラー（接続失敗など）が発生しました: {e.reason}")
    except Exception as e:
        print(f"予期せぬエラーが発生しました: {e}")

if __name__ == "__main__":
    fetch_raw_code()
